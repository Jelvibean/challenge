    "esbuild": "^0.21.3",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "typescript-eslint": "^8.31.1",
    "format": "prettier --write ."
  },
  "dependencies": {
    "fastify": "^4.27.0",
